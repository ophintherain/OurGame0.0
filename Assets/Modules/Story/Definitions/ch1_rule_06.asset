  - kind: 3
    speaker: "\u5E7F\u64AD"
    text: "\u7075\u9E1F\u554A\uFF0C\u4F60\u7684\u773C\u775B\u9057\u843D\u5728\u706B\u4E2D\uFF0C\u627E\u5BFB\u5B83\uFF0C\u6CE8\u89C6\u5B83\u3002"
