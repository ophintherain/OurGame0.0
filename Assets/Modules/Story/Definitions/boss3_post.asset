  lines:
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u8bdb\u6740\u602a\u5f02\uff1f\u8c03\u67e5\u5458001#master name#\uff0c\u597d\u9ad8\u5c1a\u7684\u4e3e\u52a8\u3002"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u4f60\u5c31\u90a3\u4e48\u786e\u4fe1\u4f60\u662f\u7279\u6b8a\u7684\uff1f\u6240\u6709\u7684\u76f8\u5173\u4eba\u5458\u90fd\u88ab\u6c61\u67d3\u3001\u5f02\u53d8\uff0c\u9664\u4e86\u4f60\u2026\u2026\uff1f"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u201c\u9ad8\u660e\u7684\u8c03\u67e5\u5458\u201d\u201cS1\u673a\u5173\u7684\u7edd\u5bf9\u9886\u5bfc\u8005\u201d\u201d\u6ca1\u4e86001\uff0cS1\u5c31\u5b8c\u86cb\u4e86\u201c\u2026\u2026\u591a\u4e48\u8363\u8a89\u7684\u8d5e\u9882\u3002"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u53ef\u662f\u6211\u4eec\u5462\uff1f001#master name#......\u4eba\u4eec\u5bf9\u4f60\u5927\u5bb6\u8d5e\u626c\uff0c\u5374\u5bf9\u6211\u907f\u4e4b\u4e0d\u53ca\u3002"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u4f60\u770b\u770b\u6211\u7684\u8138\u554a\uff0c\u770b\u770b\uff01\u8fd9\u672c\u8be5\u662f\u8363\u8000\u7684\u4e00\u90e8\u5206\uff01"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8\uff0c\u653e\u5927\u9762\u90e8\uff0c\u632f\u52a8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u597d\u75db\u554a\uff0c\u597d\u75db\uff01\u8c01\u7684\u8138\u88ab\u878d\u5316\u4e86\uff01\u672c\u8be5\u662f\u4f60\u7684\u8138\uff01\u4f60\u7684\uff01"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8\uff0c\u653e\u5927\u9762\u90e8\uff0c\u632f\u52a8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u9003\u4e0d\u6389\u7684\u2026...\u4e3a\u4f60\u7684\u7f6a\u8fc7\u5fcf\u6094\u5427\u2026..."
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10031"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u2026\u2026\u8bdb\u6740\u5f02\u5e38\uff1f\u4e0e\u81f3\u4eb2\u53ae\u6740\u5427\u2014\u2014"
    choices: []
    portraitKey: "\u7814\u7a76\u5458\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10031"
    note: ""
