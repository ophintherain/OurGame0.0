  - kind: 1
    speaker: "\u65c1\u767d"
    text: "\u6c34\u6ef4\u843d\u5904\uff0c\u8fc5\u901f\u6c47\u8d77\u6025\u6d41\u3002\u6fc0\u6d41\u5347\u6d8c\uff0c\u805a\u6210\u4eba\u5f62\uff0c\u53c8\u5728\u6781\u77ed\u65f6\u95f4\u5185\u7ed3\u6210\u51b0\u96ea\u3002"
