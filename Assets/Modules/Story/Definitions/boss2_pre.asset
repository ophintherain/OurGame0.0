    sceneTag: "10021"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u4f60\u4e0d\u4fe1\u4efb\u6211\uff0c\u4f60\u60f3\u8981\u628a\u6211\u629b\u5f00\uff01\u4f60\u5bb3\u6015\u6f6e\u6c50\u4e4b\u6db2\u6e85\u5728\u81ea\u5df1\u8eab\u4e0a\uff0c\u629b\u4e0b\u6211\u8d70\u4e86\uff01\uff01"
    choices: []
    portraitKey: "\u4f59\u6ce2\u7acb\u7ed8"
    audioCue: ""
    stageNote: "\u51fa\u573a\u8bed\u97f3\uff0c\u7acb\u7ed8"
    sceneTag: "10021"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u90a3\u5c31\u4e0d\u8981\u79bb\u5f00\u4e86\u2026\u2026\u7559\u4e0b\u6765\u2026\u2026\u6c89\u6eba\u5728\u6c34\u4e2d\u5427\uff01"
