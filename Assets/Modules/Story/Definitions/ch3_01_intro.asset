  - kind: 0
    speaker: "\u73A9\u5BB6"
    text: "\u4F60\u5C31\u8FD9\u4E48\u8FEB\u4E0D\u53CA\u5F85\u5730\u60F3\u8981\u89C1\u5230\u6211\uFF1F"
