    note: 
  - kind: 0
    speaker: "\u73A9\u5BB6"
    text: "\u2026\u2026\u4E03\u5E74\u8FC7\u53BB\u4E86\uFF0C\u8FD8\u5728\u88C5\u8154\u62FF\u8C03\u5730\u7814\u7A76\u90A3\u4E2A\u94C1\u76AE\u76D2\u5B50\u91CC\u7684\u5267\u76EE\u5417\uFF1F"
    choices: []
    portraitKey: "\u73A9\u5BB6"
    audioCue: 
    stageNote: 
    sceneTag: 1003
    note: 
  - kind: 0
    speaker: "\uFF1F\uFF1F"
    text: "\u2026\u2026\u95ED\u5634\u3002\u4F60\u4E0D\u60F3\u76F4\u63A5\u89C1\u5230\u6211\u5417\uFF1F"
