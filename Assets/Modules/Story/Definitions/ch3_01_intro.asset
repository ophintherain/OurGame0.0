  - kind: 0
    speaker: "\uFF1F\uFF1F"
    text: "\u6765\u76F4\u9762\u6211\u5427\uFF0C\u96E8\u4E2D\u7684\u8BD7\u8005\uFF0C\u98CE\u66B4\u7684\u97F3\u4E50\u5BB6\u3002"
