    sceneTag: 1003
    note: 
  - kind: 0
    speaker: "\u73A9\u5BB6"
    text: "\u6765\u5427\uFF0C\u6211\u4EEC\u5DF2\u7ECF\u6709\u4E03\u5E74\u6CA1\u89C1\u4E86\uFF0C\u897F\u8499\u3002"
    choices: []
    portraitKey: "\u73A9\u5BB6"
    audioCue: 
    stageNote: "\u8854\u63A5\u9009\u9879\uFF0Cboss\u6218\u548C\u89C4\u5219\u602A\u8C08\u540C\u671F\u51FA\u73B0\uFF0C\u53EF\u627E\u6B66\u5668"
