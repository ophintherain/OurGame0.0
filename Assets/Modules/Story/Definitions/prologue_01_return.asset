  lines:
  - kind: 1
    speaker: "\u65C1\u767D"
    text: "\u6F6E\u6C50\u4E4B\u6DB2\u6CC4\u9732\u7684\u7B2C\u4E03\u5E74\uFF0C\u4F60\u518D\u5EA6\u7AD9\u5728\u6F6E\u6C50\u5217\u8F66\u95E8\u524D\u3002"
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u9ED1\u5E95\u767D\u5B57\uFF0C\u6587\u5B57\u5C45\u4E2D\uFF0C\u9010\u53E5\u6EDA\u52A8\uFF0C\u6162\u901F\uFF1B"
    sceneTag: "\u9ED1\u5C4F"
    note: "\u6392\u5E03\u7C7B\uFF0C"
  - kind: 1
    speaker: "\u65C1\u767D"
    text: "\u4EBA\u4EEC\u8BF4\uFF0C\u4E03\u5E74\u524D\u7684\u90A3\u573A\u6C61\u67D3\u662F\u4F60\u7684\u7F6A\u8FC7\u3002"
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u9ED1\u5E95\u767D\u5B57\uFF0C\u6587\u5B57\u5C45\u4E2D\uFF0C\u9010\u53E5\u6EDA\u52A8\uFF0C\u6162\u901F\uFF1B"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\u65C1\u767D"
    text: "\u5982\u679C\u4E0D\u662F\u4F60\u64C5\u79BB\u804C\u5B88\uFF0C\u6F6E\u6C50\u4E4B\u6DB2\u5C06\u4F1A\u6210\u4E3A\u4EBA\u4EEC\u7684\u5E0C\u671B\u3002"
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u9ED1\u5E95\u767D\u5B57\uFF0C\u6587\u5B57\u5C45\u4E2D\uFF0C\u9010\u53E5\u6EDA\u52A8\uFF0C\u6162\u901F\uFF1B"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\u65C1\u767D"
    text: "\u8D2B\u7620\u65E0\u80B2\u7684\u571F\u58E4\uFF0C\u672C\u8BE5\u91CD\u7115\u751F\u673A\uFF0C\u9EA6\u7530\u672C\u8BE5\u904D\u5E03\u5927\u5730\u2026..."
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u9ED1\u5E95\u767D\u5B57\uFF0C\u6587\u5B57\u5C45\u4E2D\uFF0C\u9010\u53E5\u6EDA\u52A8\uFF0C\u6162\u901F\uFF1B"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\u65C1\u767D"
    text: "\u5982\u679C\u4E0D\u662F\u4F60\u2026..."
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u9ED1\u5E95\u767D\u5B57\uFF0C\u6587\u5B57\u5C45\u4E2D\uFF0C\u9010\u53E5\u6EDA\u52A8\uFF0C\u6162\u901F\uFF1B"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\uFF1F\uFF1F"
    text: "\u201C\u961F\u957F\uFF0C\u6709\u6211\u5728\uFF0C\u4F60\u6709\u4EC0\u4E48\u653E\u5FC3\u4E0D\u4E0B\u7684\uFF1F\u201D"
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u63D2\u5165\u9E1F\u5934\u4EBA\u8499\u7248\u7ACB\u7ED8\uFF08\u53EA\u770B\u5230\u8F6E\u5ED3\u7684\u767D\u5F71\u4EBA\uFF09"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\uFF1F\uFF1F\uFF1F"
    text: "\u201C\u961F\u957F\uFF0C\u2026......\u9047\u5230\u4F60\uFF0C\u6211\u771F\u7684\u2026\u2026\u597D\u9AD8\u5174\u2026...\u201D"
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u770B\u4E0D\u6E05\u8138\u7684\u5C0F\u5973\u5B69\uFF08\u96EA\u4E4B\u5076\uFF09\uFF0C\n\u96EA\u4E4B\u5076\u8499\u7248\u7ACB\u7ED8\uFF0C\u8499\u4E2A\u5C0F\u5973\u5B69\u5C31\u884C"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\uFF1F\uFF1F"
    text: "\u201C\u8D70\u554A\uFF0C\u8FD9\u526F\u8868\u60C5\uFF0C\u662F\u5728\u53EF\u601C\u6211\u5417\uFF1F\""
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: "\u8499\u4F4F\u8138\u7684\u7814\u7A76\u5458\u7ACB\u7ED8\uFF083\u53F7\u602A\uFF09\uFF0C\n\u4F9D\u65E7\u662F\u906E\u4F4F\u8138\u7684\u767D\u5F71\u4EBA"
    sceneTag: "\u9ED1\u5C4F"
    note: 
  - kind: 1
    speaker: "\u65C1\u767D"
    text: "\u2026..."
    choices: []
    portraitKey: 
    audioCue: 
    stageNote: 
    sceneTag: "\u9ED1\u5C4F"
    note: 
