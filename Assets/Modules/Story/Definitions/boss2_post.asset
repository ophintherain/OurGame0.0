    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u526a\u5f71"
    sceneTag: "10021"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u5e94\u8be5\u8ba9\u961f\u957f\u65e9\u70b9\u627e\u5230\u6211\uff0c\u628a\u6211\u6740\u6389\u7684\u3002"
