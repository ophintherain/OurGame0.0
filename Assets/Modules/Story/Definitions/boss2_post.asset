  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u2026\u2026\u5728\u628a\u4f60\u63a8\u5f00\u540e\uff0c\u6211\u5176\u5b9e\u5f88\u5bb3\u6015\u3002\u4f46\u5982\u679c\u8fd9\u6837\uff0c\u80fd\u8ba9\u4f60\u6d3b\u4e0b\u6765.....\u90a3\u5c31\u7559\u4e0b\u6211\u4e00\u4e2a\u4eba\u5427\u3002"
    choices: []
    portraitKey: "\u9ed1\u5973\u5b69"
    audioCue: ""
