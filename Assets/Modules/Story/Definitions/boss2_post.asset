    audioCue: ""
    stageNote: "\u51fb\u8d25\u8bed\u97f3\uff0c\u526a\u5f71"
    sceneTag: "10021"
    note: ""
  - kind: 0
    speaker: "\uff1f\uff1f"
    text: "\u2026\u2026\u5bf9\u4e0d\u8d77\u961f\u957f\uff0c\u6211\u771f\u7684\u592a\u60f3\u4f60\u4e86\u3002"
